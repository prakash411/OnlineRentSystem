pipeline {
    agent any

    triggers {
        pollSCM('* * * * *')
    }

    environment {
        PATH = "/var/lib/jenkins/.dotnet-tools:${env.PATH}"
    }

    stages {
        stage('Git Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',branches: [[name: '*/windows']],
                    userRemoteConfigs: [[url: 'https://github.com/prakash411/OnlineRentSystem.git']],
                    extensions: [
                        [$class: 'SparseCheckoutPaths', sparseCheckoutPaths: [
                            [$class: 'SparseCheckoutPath', path: 'AWS_CodeDeploy'],
                            [$class: 'SparseCheckoutPath', path: 'Database'],
                            [$class: 'SparseCheckoutPath', path: 'renter'],
                            [$class: 'SparseCheckoutPath', path: 'renter.sln']
                        ]]
                    ]
                ])
            }
        }

        stage('Restore') {
            steps {
                sh 'dotnet restore renter/renter.csproj'
            }
        }

        // stage('SonarQube Begin') {
        //     steps {
        //         withSonarQubeEnv('SonarQube') {
        //             sh '''
        //                 dotnet sonarscanner begin \
        //                   /k:"OnlineRentSystem" \
        //                   /n:"OnlineRentSystem" \
        //                   /d:sonar.exclusions="**/bin/**,**/obj/**,**/wwwroot/**"
        //             '''
        //         }
        //     }
        // }

        stage('Build') {
            steps {
                sh 'dotnet build renter/renter.csproj -c Release --no-restore'
            }
        }

        stage('Test') {
            steps {
                sh '''
                    if find . -name "*Tests.csproj" -print -quit | grep -q .; then
                        dotnet test -c Release --no-build
                    else
                        echo "No test project found. Skipping tests."
                    fi
                '''
            }
        }

        // stage('SonarQube End') {
        //     steps {
        //         withSonarQubeEnv('SonarQube') {
        //             sh 'dotnet sonarscanner end'
        //         }
        //     }
        // }

        // stage('Quality Gate') {
        //     steps {
        //         timeout(time: 5, unit: 'MINUTES') {
        //             waitForQualityGate abortPipeline: true
        //         }
        //     }
        // }

        stage('Publish') {
            steps {
                sh 'dotnet publish renter/renter.csproj -c Release -o publish --no-build'
            }
        }

        stage('Archive Artifacts') {
            steps {
                sh '''
                    cp AWS_CodeDeploy/appspec.yml publish/
                    cp -r AWS_CodeDeploy/scripts publish/
                    zip -r publish.zip publish/ 
                '''
                archiveArtifacts artifacts: 'publish.zip', fingerprint: true
            }
        }

        stage('Upload to S3') {
            steps {
                script {
                    env.AWS_ACCOUNT_ID = sh(
                        script: 'aws sts get-caller-identity --query Account --output text',
                        returnStdout: true
                    ).trim()
                    env.S3_BUCKET = "jenkins-bucket-${env.AWS_ACCOUNT_ID}-us-east-1"
                    sh "aws s3 cp publish.zip s3://${env.S3_BUCKET}/${env.JOB_NAME}/"
                    sh "aws s3 cp Database/Renter_Db-mysql.sql s3://${env.S3_BUCKET}/backup.sql"
                    sh "wget https://cdn.mysql.com/Downloads/MySQL-8.4/mysql-8.4.11-winx64.zip -O ./mysql-8.4.11-winx64.zip"
                    sh "aws s3 cp ./mysql-8.4.11-winx64.zip s3://${env.S3_BUCKET}/mysql-8.4.11-winx64.zip"                    
                    sh "wget https://awscli.amazonaws.com/AWSCLIV2-2.37.13.msi?src=script-exe -O ./AWSCLIV2-2.37.13.msi"
                    sh "aws s3 cp ./AWSCLIV2-2.37.13.msi s3://${env.S3_BUCKET}/AWSCLIV2-2.37.13.msi"
                    sh "rm ./mysql-8.4.11-winx64.zip ./AWSCLIV2-2.37.13.msi"
                }
            }
        }
    }

    post {
        success {
            echo 'CI Job get successful/stable. Now Triggering CD job...'
            echo "S3 Bucket: ${env.S3_BUCKET}"
            echo "S3 Key: ${env.JOB_NAME}/publish.zip"

            build job: 'cd-job',
            wait: false,
            parameters: [
                string(name: 'S3_BUCKET', value: "${env.S3_BUCKET}"),
                string(name: 'S3_KEY', value: "${env.JOB_NAME}/publish.zip")
            ]
        }

        failure {
            echo 'CI Job failed. CD job will not be triggered.'
        }
    }
}
